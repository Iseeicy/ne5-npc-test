[sub_resource type="GDScript" id="GDScript_xs2ha"]
script/source = "extends StaticBody3D

func _on_interactable_is_using_changed(is_using):
	if not is_using: return
	if $Light.visible: return # debounce
	
	$Light.visible = true
	$AudioStreamPlayer3D.play()
	await get_tree().create_timer(0.1).timeout
	$Light.visible = false
"

